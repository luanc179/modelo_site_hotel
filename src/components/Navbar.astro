---
import { hotelData } from '../data/hotel.js';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-neutral-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
    <a href="#" class="flex items-center shrink-0 group">
      <div class="h-11 sm:h-14 max-w-[185px] sm:max-w-[260px] flex items-center overflow-hidden rounded-xl bg-black">
        <img
          src="/images/home.jpeg"
          onerror="this.onerror=null;this.src='/images/logo.png';"
          alt="Logo Altorionegro Hotel"
          class="h-full w-auto object-contain select-none"
        />
      </div>
    </a>

    <!-- Menu Desktop -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-8 text-base font-medium text-neutral-700 shrink-0">
      <a href="#acomodacoes" class="whitespace-nowrap hover:text-emerald-900 transition">Acomodações</a>
      <a href="#sobre" class="whitespace-nowrap hover:text-emerald-900 transition">O Hotel</a>
      <a href="#localizacao" class="whitespace-nowrap hover:text-emerald-900 transition">Localização</a>
      <a href="#faq" class="whitespace-nowrap hover:text-emerald-900 transition">Dúvidas</a>
    </nav>

    <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
      <a
        href="https://www.instagram.com/hotelaltorionegro/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram Altorionegro Hotel"
        title="Siga @hotelaltorionegro no Instagram"
        class="w-10 h-10 rounded-lg border border-neutral-300 bg-stone-50 hover:bg-emerald-50 hover:border-emerald-800/40 text-emerald-900 flex items-center justify-center transition"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>

      <a
        href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de consultar disponibilidade no ${hotelData.name}.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-block whitespace-nowrap bg-emerald-900 hover:bg-emerald-800 text-white border border-amber-500/30 text-sm font-bold px-4 py-2.5 rounded-lg transition shadow-sm"
      >
        Reservar
      </a>

      <!-- Botão Sanduíche (Mobile) -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menu"
        aria-expanded="false"
        class="md:hidden w-10 h-10 rounded-lg border border-neutral-300 bg-stone-50 hover:border-emerald-800 text-emerald-900 flex items-center justify-center transition cursor-pointer"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Gaveta Mobile -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-neutral-200 px-4 py-4 space-y-3">
    <a href="#acomodacoes" class="mobile-nav-link block py-2 text-base font-medium text-neutral-800 hover:text-emerald-900">
      Acomodações
    </a>
    <a href="#sobre" class="mobile-nav-link block py-2 text-base font-medium text-neutral-800 hover:text-emerald-900">
      O Hotel
    </a>
    <a href="#localizacao" class="mobile-nav-link block py-2 text-base font-medium text-neutral-800 hover:text-emerald-900">
      Localização
    </a>
    <a href="#faq" class="mobile-nav-link block py-2 text-base font-medium text-neutral-800 hover:text-emerald-900">
      Dúvidas
    </a>
    <a
      href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de consultar disponibilidade no ${hotelData.name}.`)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="block w-full text-center bg-emerald-900 hover:bg-emerald-800 text-white border border-amber-500/30 text-sm font-bold py-2.5 rounded-lg mt-2"
    >
      Reservar pelo WhatsApp
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function toggleMenu(forceState?: boolean) {
    const isOpen = typeof forceState === 'boolean' ? forceState : menu?.classList.contains('hidden');
    if (!menu || !btn) return;
    if (isOpen) {
      menu.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  }

  btn?.addEventListener('click', () => toggleMenu());
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>