---
import { hotelData } from '../data/hotel.js';
---

<div id="room-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
  <div class="bg-white rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl transform transition-all">
    <div class="relative h-64 sm:h-80 bg-slate-200">
      <img id="modal-img" src="" alt="" class="w-full h-full object-cover">
      <button id="close-modal" aria-label="Fechar detalhes" class="absolute top-4 right-4 w-9 h-9 rounded-full bg-slate-950/70 hover:bg-slate-950 text-white flex items-center justify-center transition">
        ✕
      </button>
    </div>

    <div class="p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <h3 id="modal-title" class="text-xl sm:text-2xl font-bold text-slate-900"></h3>
        <span id="modal-rate" class="text-sm font-semibold bg-emerald-50 text-emerald-800 px-3 py-1 rounded-full"></span>
      </div>

      <p id="modal-desc" class="text-slate-600 text-sm leading-relaxed mb-4"></p>

      <div class="flex gap-4 text-xs font-medium text-slate-500 mb-4 pb-4 border-b border-slate-100">
        <span id="modal-size"></span>
        <span>•</span>
        <span id="modal-bed"></span>
      </div>

      <ul id="modal-amenities" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700 mb-6"></ul>

      <div class="flex justify-end gap-3">
        <button id="modal-cancel" class="px-4 py-2.5 rounded-lg border border-slate-300 text-slate-700 text-sm font-medium hover:bg-slate-50 transition">
          Fechar
        </button>
        <a id="modal-cta" href="#" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-semibold transition">
          Reservar este Quarto
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ rooms: hotelData.rooms, whatsapp: hotelData.whatsapp, hotelName: hotelData.name }}>
  const modal = document.getElementById('room-modal');
  const closeBtn = document.getElementById('close-modal');
  const cancelBtn = document.getElementById('modal-cancel');

  function openRoomModal(roomId) {
    const room = rooms.find(r => r.id === roomId);
    if (!room) return;

    const imgEl = document.getElementById('modal-img');
    imgEl.src = room.image;
    imgEl.onerror = () => { imgEl.src = room.fallback; };

    document.getElementById('modal-title').textContent = room.name;
    document.getElementById('modal-rate').textContent = `Ref. R$ ${room.dailyRate}/diária`;
    document.getElementById('modal-desc').textContent = room.description;
    document.getElementById('modal-size').textContent = `Área: ${room.size}`;
    document.getElementById('modal-bed').textContent = room.bed;

    const list = document.getElementById('modal-amenities');
    list.innerHTML = room.amenities.map(item => `<li>✓ ${item}</li>`).join('');

    const msg = `Olá! Vi os detalhes do *${room.name}* no site do ${hotelName} e gostaria de consultar disponibilidade.`;
    document.getElementById('modal-cta').href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeRoomModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.querySelectorAll('[data-open-room]').forEach(el => {
    el.addEventListener('click', () => openRoomModal(el.dataset.openRoom));
  });

  closeBtn?.addEventListener('click', closeRoomModal);
  cancelBtn?.addEventListener('click', closeRoomModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeRoomModal();
  });
</script>