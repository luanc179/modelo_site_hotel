---
import { hotelData } from '../data/hotel.js';
---

<div id="room-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-neutral-950/75 backdrop-blur-sm p-4">
  <div class="bg-white border border-neutral-200 rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl transform transition-all">
    <div class="relative h-64 sm:h-80 bg-neutral-100 select-none">
      <img id="modal-img" src="" alt="" class="w-full h-full object-cover transition-opacity duration-200">

      <button id="prev-photo" type="button" aria-label="Foto anterior" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 hover:bg-white text-emerald-950 border border-neutral-300 flex items-center justify-center transition cursor-pointer shadow">
        ‹
      </button>
      <button id="next-photo" type="button" aria-label="Próxima foto" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 hover:bg-white text-emerald-950 border border-neutral-300 flex items-center justify-center transition cursor-pointer shadow">
        ›
      </button>

      <span id="photo-counter" class="absolute bottom-3 left-3 bg-emerald-950/85 text-amber-300 border border-amber-400/30 text-xs font-medium px-2.5 py-1 rounded-md">
        1 / 1
      </span>

      <button id="close-modal" type="button" aria-label="Fechar detalhes" class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 hover:bg-white text-neutral-900 border border-neutral-300 flex items-center justify-center transition cursor-pointer shadow">
        ✕
      </button>
    </div>

    <div class="p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
        <h3 id="modal-title" class="text-xl sm:text-2xl font-bold text-neutral-900"></h3>
        <span id="modal-rate" class="text-sm font-semibold bg-emerald-50 text-emerald-900 border border-emerald-800/25 px-3 py-1 rounded-full"></span>
      </div>

      <p id="modal-desc" class="text-neutral-700 text-sm leading-relaxed mb-4"></p>

      <div class="flex gap-4 text-xs font-medium text-neutral-500 mb-4 pb-4 border-b border-neutral-200">
        <span id="modal-size"></span>
        <span>•</span>
        <span id="modal-bed"></span>
      </div>

      <ul id="modal-amenities" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-neutral-700 mb-6"></ul>

      <div class="flex justify-end gap-3">
        <button id="modal-cancel" type="button" class="px-4 py-2.5 rounded-lg border border-neutral-300 text-neutral-700 text-sm font-medium hover:bg-neutral-100 transition cursor-pointer">
          Fechar
        </button>
        <a id="modal-cta" href="#" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-lg bg-emerald-900 hover:bg-emerald-800 text-white border border-amber-500/30 text-sm font-bold transition">
          Reservar este Quarto
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ rooms: hotelData.rooms, whatsapp: hotelData.whatsapp, hotelName: hotelData.name }}>
  const modal = document.getElementById('room-modal');
  const imgEl = document.getElementById('modal-img');
  const counterEl = document.getElementById('photo-counter');
  const prevBtn = document.getElementById('prev-photo');
  const nextBtn = document.getElementById('next-photo');

  let currentRoom = null;
  let currentPhotoIndex = 0;

  function renderPhoto() {
    if (!currentRoom) return;
    const photos = currentRoom.images && currentRoom.images.length ? currentRoom.images : [currentRoom.image];
    imgEl.src = photos[currentPhotoIndex];
    imgEl.onerror = () => { imgEl.src = currentRoom.fallback; };
    counterEl.textContent = `${currentPhotoIndex + 1} / ${photos.length}`;

    const showArrows = photos.length > 1;
    prevBtn.style.display = showArrows ? 'flex' : 'none';
    nextBtn.style.display = showArrows ? 'flex' : 'none';
  }

  function openRoomModal(roomId) {
    currentRoom = rooms.find(r => r.id === roomId);
    if (!currentRoom) return;
    currentPhotoIndex = 0;

    renderPhoto();
    document.getElementById('modal-title').textContent = currentRoom.name;
    document.getElementById('modal-rate').textContent = `Ref. R$ ${currentRoom.dailyRate}/diária`;
    document.getElementById('modal-desc').textContent = currentRoom.description;
    document.getElementById('modal-size').textContent = `Área: ${currentRoom.size}`;
    document.getElementById('modal-bed').textContent = currentRoom.bed;

    const list = document.getElementById('modal-amenities');
    list.innerHTML = currentRoom.amenities.map(item => `<li><span class="text-emerald-800 font-bold">✓</span> ${item}</li>`).join('');

    const msg = `Olá! Vi os detalhes do *${currentRoom.name}* no site do ${hotelName} e gostaria de consultar disponibilidade.`;
    document.getElementById('modal-cta').href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`;

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeRoomModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  prevBtn?.addEventListener('click', () => {
    if (!currentRoom) return;
    const total = currentRoom.images?.length || 1;
    currentPhotoIndex = (currentPhotoIndex - 1 + total) % total;
    renderPhoto();
  });

  nextBtn?.addEventListener('click', () => {
    if (!currentRoom) return;
    const total = currentRoom.images?.length || 1;
    currentPhotoIndex = (currentPhotoIndex + 1) % total;
    renderPhoto();
  });

  document.querySelectorAll('[data-open-room]').forEach(el => {
    el.addEventListener('click', () => openRoomModal(el.dataset.openRoom));
  });

  document.getElementById('close-modal')?.addEventListener('click', closeRoomModal);
  document.getElementById('modal-cancel')?.addEventListener('click', closeRoomModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeRoomModal();
  });
</script>