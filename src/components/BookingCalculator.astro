---
import { hotelData } from '../data/hotel.js';
---

<div class="mt-10 bg-white text-slate-800 p-5 sm:p-6 rounded-2xl shadow-2xl border border-slate-100">
  <form id="booking-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
    <div>
      <label for="checkin" class="block text-xs font-semibold text-slate-500 uppercase mb-1">Entrada (Check-in)</label>
      <input type="date" id="checkin" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-emerald-600">
    </div>

    <div>
      <label for="checkout" class="block text-xs font-semibold text-slate-500 uppercase mb-1">Saída (Check-out)</label>
      <input type="date" id="checkout" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-emerald-600">
    </div>

    <div>
      <label for="room-select" class="block text-xs font-semibold text-slate-500 uppercase mb-1">Acomodação</label>
      <select id="room-select" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm bg-white focus:outline-none focus:border-emerald-600">
        {hotelData.rooms.map((room) => (
          <option value={room.id} data-rate={room.dailyRate} data-name={room.name}>
            {room.name}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label for="guests" class="block text-xs font-semibold text-slate-500 uppercase mb-1">Hóspedes</label>
      <select id="guests" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 text-sm bg-white focus:outline-none focus:border-emerald-600">
        <option value="1 Adulto">1 Adulto</option>
        <option value="2 Adultos">2 Adultos</option>
        <option value="3 Adultos">3 Adultos</option>
        <option value="Grupo / Corporativo">Grupo / Corporativo</option>
      </select>
    </div>

    <button type="submit" class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-semibold py-2.5 px-4 rounded-lg transition text-sm h-[42px] shadow-sm">
      Solicitar no WhatsApp
    </button>
  </form>

  <!-- Barra de Resumo Dinâmico -->
  <div id="estimate-bar" class="hidden mt-4 pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-sm">
    <div class="text-slate-600">
      Período selecionado: <strong id="nights-count" class="text-slate-900">0 diárias</strong>
    </div>
    <div class="text-slate-700">
      Estimativa direta (sujeita à confirmação): <strong id="total-estimate" class="text-emerald-700 text-base">R$ 0,00</strong>
    </div>
  </div>
</div>

<script define:vars={{ whatsapp: hotelData.whatsapp, hotelName: hotelData.name }}>
  const checkinInput = document.getElementById('checkin');
  const checkoutInput = document.getElementById('checkout');
  const roomSelect = document.getElementById('room-select');
  const guestsSelect = document.getElementById('guests');
  const estimateBar = document.getElementById('estimate-bar');
  const nightsCountEl = document.getElementById('nights-count');
  const totalEstimateEl = document.getElementById('total-estimate');
  const form = document.getElementById('booking-form');

  // Define data mínima como hoje
  const today = new Date().toISOString().split('T')[0];
  checkinInput.min = today;
  checkoutInput.min = today;

  function calculateEstimate() {
    if (!checkinInput.value || !checkoutInput.value) {
      estimateBar.classList.add('hidden');
      return null;
    }

    const start = new Date(checkinInput.value + 'T12:00:00');
    const end = new Date(checkoutInput.value + 'T12:00:00');
    const diffTime = end - start;
    const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    if (nights <= 0) {
      estimateBar.classList.add('hidden');
      return null;
    }

    const selectedOption = roomSelect.options[roomSelect.selectedIndex];
    const rate = Number(selectedOption.dataset.rate || 0);
    const total = nights * rate;

    nightsCountEl.textContent = `${nights} ${nights === 1 ? 'diária' : 'diárias'}`;
    totalEstimateEl.textContent = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    estimateBar.classList.remove('hidden');

    return { nights, total, roomName: selectedOption.dataset.name };
  }

  checkinInput.addEventListener('change', () => {
    checkoutInput.min = checkinInput.value;
    calculateEstimate();
  });
  checkoutInput.addEventListener('change', calculateEstimate);
  roomSelect.addEventListener('change', calculateEstimate);

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const calc = calculateEstimate();
    const selectedOption = roomSelect.options[roomSelect.selectedIndex];
    const roomName = selectedOption.dataset.name;
    const inFormatted = checkinInput.value.split('-').reverse().join('/');
    const outFormatted = checkoutInput.value.split('-').reverse().join('/');

    let msg = `Olá! Gostaria de consultar disponibilidade no *${hotelName}*.\n\n`;
    msg += `• *Check-in:* ${inFormatted}\n`;
    msg += `• *Check-out:* ${outFormatted}\n`;
    if (calc) msg += `• *Período:* ${calc.nights} ${calc.nights === 1 ? 'diária' : 'diárias'}\n`;
    msg += `• *Acomodação:* ${roomName}\n`;
    msg += `• *Hóspedes:* ${guestsSelect.value}\n`;
    if (calc) msg += `• *Estimativa exibida no site:* ${calc.total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })}`;

    window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`, '_blank');
  });
</script>