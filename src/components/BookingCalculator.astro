---
import { hotelData } from '../data/hotel.js';
---

<div class="bg-white rounded-2xl shadow-lg p-5 sm:p-6 border border-neutral-200">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
    <div>
      <label for="checkin" class="block text-xs font-semibold uppercase tracking-wider text-emerald-900 mb-1.5">
        Entrada (Check-in)
      </label>
      <input
        type="date"
        id="checkin"
        class="w-full rounded-lg bg-stone-50 border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 focus:border-emerald-800 focus:outline-none [color-scheme:light]"
      />
    </div>

    <div>
      <label for="checkout" class="block text-xs font-semibold uppercase tracking-wider text-emerald-900 mb-1.5">
        Saída (Check-out)
      </label>
      <input
        type="date"
        id="checkout"
        class="w-full rounded-lg bg-stone-50 border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 focus:border-emerald-800 focus:outline-none [color-scheme:light]"
      />
    </div>

    <div>
      <label for="room-select" class="block text-xs font-semibold uppercase tracking-wider text-emerald-900 mb-1.5">
        Acomodação
      </label>
      <select
        id="room-select"
        class="w-full rounded-lg bg-stone-50 border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 focus:border-emerald-800 focus:outline-none"
      >
        {hotelData.rooms.map((room) => (
          <option value={room.id} data-rate={room.dailyRate} data-name={room.name}>
            {room.name} (R$ {room.dailyRate}/dia)
          </option>
        ))}
      </select>
    </div>

    <div>
      <label for="guests" class="block text-xs font-semibold uppercase tracking-wider text-emerald-900 mb-1.5">
        Hóspedes
      </label>
      <select
        id="guests"
        class="w-full rounded-lg bg-stone-50 border border-neutral-300 px-3 py-2.5 text-sm text-neutral-900 focus:border-emerald-800 focus:outline-none"
      >
        <option value="1 Adulto">1 Adulto</option>
        <option value="2 Adultos">2 Adultos</option>
        <option value="3 Adultos">3 Adultos</option>
        <option value="Família / Equipe">Família / Equipe</option>
      </select>
    </div>

    <div>
      <button
        id="btn-calc-whatsapp"
        type="button"
        class="w-full bg-emerald-900 hover:bg-emerald-800 text-white border border-amber-500/30 font-bold text-sm py-2.5 px-4 rounded-lg transition shadow-sm cursor-pointer"
      >
        Solicitar no WhatsApp
      </button>
    </div>
  </div>

  <div id="estimate-bar" class="hidden mt-4 pt-3 border-t border-neutral-200 flex flex-wrap items-center justify-between gap-2 text-sm">
    <span class="text-neutral-700" id="estimate-details"></span>
    <span class="font-bold text-emerald-900" id="estimate-total"></span>
  </div>
</div>

<script define:vars={{ whatsapp: hotelData.whatsapp, hotelName: hotelData.name }}>
  const checkinInput = document.getElementById('checkin');
  const checkoutInput = document.getElementById('checkout');
  const roomSelect = document.getElementById('room-select');
  const guestsSelect = document.getElementById('guests');
  const estimateBar = document.getElementById('estimate-bar');
  const estimateDetails = document.getElementById('estimate-details');
  const estimateTotal = document.getElementById('estimate-total');
  const btnWhatsapp = document.getElementById('btn-calc-whatsapp');

  const today = new Date().toISOString().split('T')[0];
  checkinInput.min = today;
  checkoutInput.min = today;

  function formatDateBR(dateStr) {
    if (!dateStr) return '';
    const [y, m, d] = dateStr.split('-');
    return `${d}/${m}/${y}`;
  }

  function calculateStay() {
    const inVal = checkinInput.value;
    const outVal = checkoutInput.value;
    const selectedOption = roomSelect.options[roomSelect.selectedIndex];
    const rate = Number(selectedOption.dataset.rate || 0);
    const roomName = selectedOption.dataset.name;

    if (!inVal || !outVal) {
      estimateBar.classList.add('hidden');
      return null;
    }

    const d1 = new Date(inVal + 'T00:00:00');
    const d2 = new Date(outVal + 'T00:00:00');
    const diffDays = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));

    if (diffDays <= 0) {
      estimateBar.classList.remove('hidden');
      estimateDetails.textContent = 'Selecione uma data de saída posterior à entrada.';
      estimateTotal.textContent = '';
      return null;
    }

    const total = diffDays * rate;
    estimateBar.classList.remove('hidden');
    estimateDetails.textContent = `${diffDays} diária(s) • ${roomName} (${guestsSelect.value})`;
    estimateTotal.textContent = `Estimativa: R$ ${total.toLocaleString('pt-BR')},00`;

    return { inVal, outVal, diffDays, roomName, total, guests: guestsSelect.value };
  }

  checkinInput.addEventListener('change', () => {
    checkoutInput.min = checkinInput.value || today;
    calculateStay();
  });
  checkoutInput.addEventListener('change', calculateStay);
  roomSelect.addEventListener('change', calculateStay);
  guestsSelect.addEventListener('change', calculateStay);

  btnWhatsapp.addEventListener('click', () => {
    const stay = calculateStay();
    let msg = `Olá! Gostaria de consultar disponibilidade no *${hotelName}*.`;

    if (stay) {
      msg = `Olá! Gostaria de verificar disponibilidade no *${hotelName}*:\n\n` +
            `• *Acomodação:* ${stay.roomName}\n` +
            `• *Check-in:* ${formatDateBR(stay.inVal)}\n` +
            `• *Check-out:* ${formatDateBR(stay.outVal)} (${stay.diffDays} diária(s))\n` +
            `• *Hóspedes:* ${stay.guests}\n` +
            `• *Estimativa:* R$ ${stay.total.toLocaleString('pt-BR')},00`;
    } else {
      const selectedOption = roomSelect.options[roomSelect.selectedIndex];
      msg = `Olá! Gostaria de cotar o *${selectedOption.dataset.name}* para *${guestsSelect.value}* no *${hotelName}*.`;
    }

    window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener,noreferrer');
  });
</script>