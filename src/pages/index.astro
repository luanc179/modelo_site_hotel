---
import '../styles/global.css';
import { hotelData } from '../data/hotel.js';
import Navbar from '../components/Navbar.astro';
import BookingCalculator from '../components/BookingCalculator.astro';
import RoomGalleryModal from '../components/RoomGalleryModal.astro';
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{hotelData.name} | Hospedagem em São Gabriel da Cachoeira - AM</title>
    <meta
      name="description"
      content="Uma nova experiência na Amazônia. Hospedagem, turismo e corporativo em São Gabriel da Cachoeira a poucos passos da praia do Rio Negro."
    />
    <!-- Favicon usando a própria logo do Altorionegro Hotel -->
    <link rel="icon" type="image/jpeg" href="/images/logo.jpeg" />
    <link rel="apple-touch-icon" href="/images/logo.jpeg" />
  </head>
  <body class="bg-stone-50 text-neutral-900 antialiased selection:bg-emerald-900/20 selection:text-emerald-950">
    <Navbar />

    <!-- Hero com imagem menor à direita e visual limpo -->
    <section class="bg-white text-neutral-900 border-b border-neutral-200 pt-8 sm:pt-12 pb-14 sm:pb-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-12 mb-10 sm:mb-12">
          <!-- Coluna esquerda: texto principal -->
          <div class="w-full lg:flex-1 text-left">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest text-white bg-emerald-900 border border-emerald-800 px-3.5 py-1.5 rounded-full mb-4">
              Hospedagem • Turismo • Corporativo
            </span>
            <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-tight text-neutral-900 mb-3.5">
              Uma nova experiência em <span class="text-emerald-900">São Gabriel da Cachoeira.</span>
            </h1>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed max-w-xl">
              Quartos amplos, climatizados e pensados para o seu bem-estar, a poucos passos da praia do Rio Negro. Simule suas diárias e fale direto com nossa recepção.
            </p>
          </div>

          <!-- Coluna direita: logo preta e dourada em moldura arredondada -->
          <div class="relative w-full max-w-[300px] sm:max-w-[340px] lg:w-[320px] shrink-0 overflow-hidden rounded-2xl bg-black ">
            <img
              src="/images/capa.jpeg"
              onerror={`this.onerror=null;this.src='${hotelData.heroFallback}';`}
              alt={`Capa ${hotelData.name}`}
              class="w-full h-auto object-contain rounded-xl select-none pointer-events-none"
            />
          </div>
        </div>

        <!-- Simulador logo abaixo -->
        <BookingCalculator />
      </div>
    </section>

    <!-- Acomodações -->
    <section id="acomodacoes" class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-800 mb-1">Acomodações</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900">Conforto em cada detalhe</h2>
        </div>
        <p class="text-sm text-neutral-600">Clique na foto ou em "Ver Detalhes" para ampliar a galeria.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {hotelData.rooms.map((room) => (
          <article class="bg-white rounded-2xl border border-neutral-200 hover:border-emerald-800/40 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col">
            <button
              type="button"
              data-open-room={room.id}
              class="relative h-56 w-full overflow-hidden group text-left cursor-pointer bg-neutral-100"
            >
              <img
                src={room.image}
                onerror={`this.onerror=null;this.src='${room.fallback}';`}
                alt={room.name}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
              />
              <span class="absolute bottom-3 right-3 bg-emerald-950/85 border border-amber-400/40 text-amber-300 text-xs font-medium px-2.5 py-1 rounded-md">
                Ampliar fotos
              </span>
            </button>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-neutral-900 mb-1">{room.name}</h3>
                <p class="text-xs text-amber-700 font-semibold mb-3">{room.bed} • {room.size}</p>
                <p class="text-sm text-neutral-600 leading-relaxed mb-5">{room.description}</p>
              </div>

              <div class="pt-4 border-t border-neutral-100 flex items-center justify-between gap-2">
                <button
                  type="button"
                  data-open-room={room.id}
                  class="text-xs font-semibold text-neutral-700 hover:text-emerald-900 transition cursor-pointer"
                >
                  Ver Detalhes
                </button>
                <a
                  href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de cotar o *${room.name}* no ${hotelData.name}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-emerald-900 hover:bg-emerald-800 text-white border border-amber-500/30 text-xs font-bold px-3.5 py-2 rounded-lg transition"
                >
                  Cotar no WhatsApp
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Espaço da Marca / Logo Grande + Diferenciais -->
    <section id="sobre" class="bg-white border-y border-neutral-200 py-16 sm:py-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Vitrine da Logo Grande -->
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 bg-stone-50 border border-neutral-200 rounded-3xl p-8 sm:p-12 mb-12 shadow-sm">
          <div class="relative shrink-0">
            <div class="absolute -inset-2 rounded-3xl bg-amber-500/15 blur-xl"></div>
            <div class="relative w-32 h-32 sm:w-40 sm:h-40 rounded-2xl border-amber-500/60 flex items-center justify-center overflow-hidden shadow-lg">
              <img
                src="/images/logo.jpeg"
                alt="Logotipo Altorionegro Hotel"
                class="w-full h-full object-contain p-2"
              />
            </div>
          </div>

          <div class="text-center md:text-left flex-1">
            <span class="text-xs font-bold uppercase tracking-[0.25em] text-amber-700 block mb-2">
              Uma nova experiência na Amazônia
            </span>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-emerald-950 tracking-wide uppercase mb-3">
              Altorionegro Hotel
            </h2>
            <p class="text-neutral-700 text-sm sm:text-base leading-relaxed max-w-2xl mb-6">
              Inspirado nas curvas e na imponência do Rio Negro, o Altorionegro Hotel une hospitalidade acolhedora, estrutura moderna e localização estratégica em São Gabriel da Cachoeira para quem viaja a trabalho, missão ou turismo.
            </p>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
              <a
                href="https://www.instagram.com/hotelaltorionegro/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 bg-emerald-900 hover:bg-emerald-800 border border-amber-500/40 text-amber-200 font-semibold text-sm px-5 py-2.5 rounded-xl transition"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Acompanhe @hotelaltorionegro</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Grid de 4 Diferenciais -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-5 rounded-xl bg-stone-50 border border-neutral-200">
            <h3 class="font-bold text-emerald-900 mb-1">A Passos do Rio Negro</h3>
            <p class="text-sm text-neutral-600">Localização privilegiada próxima à praia do Rio Negro e ao centro comercial.</p>
          </div>
          <div class="p-5 rounded-xl bg-stone-50 border border-neutral-200">
            <h3 class="font-bold text-emerald-900 mb-1">Climatização & Conforto</h3>
            <p class="text-sm text-neutral-600">Apartamentos amplos com ar-condicionado e acabamento moderno para descanso pleno.</p>
          </div>
          <div class="p-5 rounded-xl bg-stone-50 border border-neutral-200">
            <h3 class="font-bold text-emerald-900 mb-1">Ideal para Corporativo</h3>
            <p class="text-sm text-neutral-600">Conectividade e estrutura preparadas para missões, empresas e viagens a trabalho.</p>
          </div>
          <div class="p-5 rounded-xl bg-stone-50 border border-neutral-200">
            <h3 class="font-bold text-emerald-900 mb-1">Atendimento Direto</h3>
            <p class="text-sm text-neutral-600">Negociação rápida pelo WhatsApp para individuais, famílias ou grupos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Localização -->
    <section id="localizacao" class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-800 mb-1">Localização</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900 mb-4">Areia branca e águas negras a poucos passos</h2>
          <p class="text-neutral-700 text-sm sm:text-base leading-relaxed mb-6">
            Situado na Av. Sete de Setembro, com fácil acesso à orla do Rio Negro, bancos, restaurantes e principais pontos de apoio de São Gabriel da Cachoeira.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Poderia me enviar a localização e orientações de chegada do ${hotelData.name}?`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block bg-emerald-900 hover:bg-emerald-800 text-white border border-amber-500/30 font-bold text-sm px-5 py-3 rounded-lg transition"
            >
              Pedir Localização no WhatsApp
            </a>
            <a
              href="https://maps.app.goo.gl/Bv4LH7HmDutJioUJ9"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block border border-neutral-300 hover:border-emerald-900 text-neutral-800 hover:text-emerald-950 bg-white font-semibold text-sm px-5 py-3 rounded-lg transition"
            >
              Abrir no Google Maps
            </a>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden border border-neutral-200 shadow-md h-80 bg-white">
          <iframe
            src="https://maps.google.com/maps?q=-0.135833,-67.083306&t=&z=17&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de localização"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-16 bg-white border-t border-neutral-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-800 mb-1">Dúvidas frequentes</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-neutral-900">Informações essenciais para sua estadia</h2>
        </div>

        <div class="space-y-3">
          <details class="group bg-stone-50 rounded-xl border border-neutral-200 p-5 open:border-emerald-800/40 transition">
            <summary class="flex items-center justify-between font-semibold text-neutral-900 cursor-pointer list-none">
              <span>Quais são os horários de check-in e check-out?</span>
              <span class="text-emerald-900 group-open:rotate-180 transition-transform">⌄</span>
            </summary>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">
              O check-in inicia às 14h e o check-out vai até as 12h. Caso seu voo ou chegada ocorra mais cedo, entre em contato pelo WhatsApp para verificar disponibilidade de entrada antecipada ou guarda de bagagem.
            </p>
          </details>

          <details class="group bg-stone-50 rounded-xl border border-neutral-200 p-5 open:border-emerald-800/40 transition">
            <summary class="flex items-center justify-between font-semibold text-neutral-900 cursor-pointer list-none">
              <span>O hotel oferece Wi-Fi estável e estrutura para trabalho?</span>
              <span class="text-emerald-900 group-open:rotate-180 transition-transform">⌄</span>
            </summary>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">
              Sim. Os apartamentos contam com climatização e conectividade pensada para quem viaja a trabalho, turismo ou missão. Confirme com nossa recepção os detalhes operacionais do período da sua estadia.
            </p>
          </details>

          <details class="group bg-stone-50 rounded-xl border border-neutral-200 p-5 open:border-emerald-800/40 transition">
            <summary class="flex items-center justify-between font-semibold text-neutral-900 cursor-pointer list-none">
              <span>Quais formas de pagamento são aceitas e há emissão de nota fiscal?</span>
              <span class="text-emerald-900 group-open:rotate-180 transition-transform">⌄</span>
            </summary>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">
              Aceitamos Pix, dinheiro e cartões. Para empresas, órgãos públicos ou prestação de contas, solicite previamente as condições de faturamento e emissão de nota fiscal no atendimento pelo WhatsApp.
            </p>
          </details>

          <details class="group bg-stone-50 rounded-xl border border-neutral-200 p-5 open:border-emerald-800/40 transition">
            <summary class="flex items-center justify-between font-semibold text-neutral-900 cursor-pointer list-none">
              <span>Como faço para reservar ou cotar para grupos/equipes?</span>
              <span class="text-emerald-900 group-open:rotate-180 transition-transform">⌄</span>
            </summary>
            <p class="mt-3 text-sm text-neutral-600 leading-relaxed">
              Use o simulador de diárias no topo da página ou clique em "Cotar no WhatsApp" em qualquer apartamento. Para equipes, missões ou estadias prolongadas, envie a quantidade de quartos e datas para atendimento direto.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- Footer com Instagram -->
    <footer class="bg-emerald-950 text-neutral-300 py-10 border-t border-amber-500/25 text-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-4">
        <div>
          <p class="text-white font-semibold">{hotelData.name} • {hotelData.city}</p>
          <p class="text-xs text-emerald-200/75 mt-0.5">Reservas e atendimento direto via WhatsApp</p>
        </div>

        <a
          href="https://www.instagram.com/hotelaltorionegro/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-amber-300 hover:text-amber-200 font-medium transition"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>@hotelaltorionegro</span>
        </a>
      </div>
    </footer>

    <!-- Botão Flutuante WhatsApp -->
    <a
      href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de falar com a recepção do ${hotelData.name}.`)}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Falar no WhatsApp"
      class="fixed bottom-6 right-6 z-40 inline-flex items-center gap-2.5 rounded-full bg-emerald-800 hover:bg-emerald-700 text-white border border-amber-400/40 font-bold text-base px-5 py-3.5 shadow-xl hover:shadow-2xl hover:-translate-y-0.5 transition-all"
    >
      <svg class="w-6 h-6 fill-current text-amber-300" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <RoomGalleryModal />
  </body>
</html>