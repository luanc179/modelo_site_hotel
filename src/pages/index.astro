---
import { hotelData } from '../data/hotel.js';
import Navbar from '../components/Navbar.astro';
import BookingCalculator from '../components/BookingCalculator.astro';
import RoomGalleryModal from '../components/RoomGalleryModal.astro';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{hotelData.name} | São Gabriel da Cachoeira - AM</title>
  <meta name="description" content={`Hospedagem confortável em São Gabriel da Cachoeira. Reserve direto no ${hotelData.name} sem taxas de aplicativos.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="bg-slate-50 text-slate-800 antialiased" style="font-family: 'Inter', sans-serif;">

  <Navbar />

  <!-- Hero -->
  <section class="relative bg-slate-900 text-white">
    <div class="absolute inset-0 overflow-hidden">
      <img
        src={hotelData.heroImage}
        onerror={`this.src='${hotelData.heroFallback}'`}
        alt={hotelData.name}
        class="w-full h-full object-cover opacity-40"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-transparent"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-20 pb-24 md:pt-28 md:pb-32">
      <div class="max-w-2xl">
        <span class="inline-block bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-semibold px-3 py-1 rounded-full mb-4">
          {hotelData.city}
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-tight mb-4">
          Conforto e agilidade na sua estadia em São Gabriel da Cachoeira.
        </h1>
        <p class="text-slate-200 text-base sm:text-lg leading-relaxed">
          Simule suas diárias abaixo e fale diretamente com nossa recepção pelo WhatsApp — sem taxas de intermediários.
        </p>
      </div>

      <BookingCalculator />
    </div>
  </section>

  <!-- Acomodações -->
  <section id="acomodacoes" class="py-16 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-emerald-700 font-semibold text-sm uppercase tracking-wider">Acomodações</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">Conheça nossos apartamentos</h2>
        </div>
        <p class="text-sm text-slate-600">Clique na foto ou em "Ver Detalhes" para ampliar.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {hotelData.rooms.map((room) => (
          <article class="group bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col">
            <button type="button" data-open-room={room.id} class="relative h-56 overflow-hidden text-left block w-full">
              <img
                src={room.image}
                onerror={`this.src='${room.fallback}'`}
                alt={room.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <span class="absolute bottom-3 right-3 bg-slate-950/75 text-white text-xs font-medium px-2.5 py-1 rounded-md">
                Ampliar fotos
              </span>
            </button>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-slate-900">{room.name}</h3>
                <p class="text-xs text-emerald-700 font-medium mt-1">{room.bed} • {room.size}</p>
                <p class="text-sm text-slate-600 mt-3 leading-relaxed">{room.description}</p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
                <button
                  type="button"
                  data-open-room={room.id}
                  class="text-sm font-semibold text-slate-700 hover:text-emerald-800 transition"
                >
                  Ver Detalhes
                </button>
                <a
                  href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de cotar o *${room.name}* no ${hotelData.name}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-slate-900 hover:bg-emerald-800 text-white text-xs font-semibold px-4 py-2.5 rounded-lg transition"
                >
                  Cotar no WhatsApp
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Estrutura -->
  <section id="estrutura" class="py-16 bg-white border-y border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-6 rounded-xl bg-slate-50 border border-slate-100">
        <h3 class="font-bold text-slate-900 mb-1">Wi-Fi Estável</h3>
        <p class="text-sm text-slate-600">Conectividade nos apartamentos e recepção para trabalho remoto e chamadas.</p>
      </div>
      <div class="p-6 rounded-xl bg-slate-50 border border-slate-100">
        <h3 class="font-bold text-slate-900 mb-1">Café da Manhã</h3>
        <p class="text-sm text-slate-600">Opções frescas inclusas na diária para começar bem o dia na cidade.</p>
      </div>
      <div class="p-6 rounded-xl bg-slate-50 border border-slate-100">
        <h3 class="font-bold text-slate-900 mb-1">Climatização Split</h3>
        <p class="text-sm text-slate-600">Apartamentos equipados com ar-condicionado, frigobar e banheiro privativo.</p>
      </div>
      <div class="p-6 rounded-xl bg-slate-50 border border-slate-100">
        <h3 class="font-bold text-slate-900 mb-1">Nota Fiscal</h3>
        <p class="text-sm text-slate-600">Atendimento preparado para empresas, instituições e servidores em viagem.</p>
      </div>
    </div>
  </section>

  <!-- Localização -->
  <section id="localizacao" class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <span class="text-emerald-700 font-semibold text-sm uppercase tracking-wider">Localização</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1 mb-4">Fácil acesso em São Gabriel da Cachoeira</h2>
        <p class="text-slate-600 text-sm sm:text-base mb-6 leading-relaxed">
          Próximo ao comércio, bancos e pontos de apoio da cidade. Entre em contato para receber nossa localização exata pelo WhatsApp.
        </p>
        <p class="text-sm text-slate-700 mb-6"><strong>Instagram oficial:</strong> {hotelData.instagram}</p>
        <a
          href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de receber a localização exata do ${hotelData.name}.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-emerald-700 hover:bg-emerald-800 text-white font-semibold px-6 py-3 rounded-lg transition"
        >
          Pedir Localização no WhatsApp
        </a>
      </div>

      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm h-80">
        <iframe
          src="https://maps.google.com/maps?q=-0.135833,-67.083306&t=&z=17&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
        <a href="[https://maps.app.goo.gl/Bv4LH7HmDutJioUJ9](https://maps.app.goo.gl/Bv4LH7HmDutJioUJ9)" target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-xs font-semibold text-emerald-700 hover:underline">Abrir localização no aplicativo Google Maps →</a>
      </div>
    </div>
  </section>

<section id="faq" class="py-16 bg-slate-50 border-t border-slate-200/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <p class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Dúvidas frequentes</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Informações essenciais para sua estadia</h2>
    </div>

    <div class="space-y-3">
      <details class="group bg-white rounded-xl border border-slate-200 p-5 open:shadow-sm transition">
        <summary class="flex items-center justify-between font-semibold text-slate-900 cursor-pointer list-none">
          <span>Quais são os horários de check-in e check-out?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">⌄</span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          O check-in inicia às 14h e o check-out vai até as 12h. Caso seu voo ou chegada ocorra mais cedo, entre em contato pelo WhatsApp para verificar disponibilidade de entrada antecipada ou guarda de bagagem.
        </p>
      </details>

      <details class="group bg-white rounded-xl border border-slate-200 p-5 open:shadow-sm transition">
        <summary class="flex items-center justify-between font-semibold text-slate-900 cursor-pointer list-none">
          <span>O hotel oferece Wi-Fi estável e respaldo para energia/água?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">⌄</span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          Sim. Os apartamentos contam com climatização e conectividade pensada para quem viaja a trabalho ou lazer. Confirme com nossa recepção os detalhes operacionais do período da sua estadia.
        </p>
      </details>

      <details class="group bg-white rounded-xl border border-slate-200 p-5 open:shadow-sm transition">
        <summary class="flex items-center justify-between font-semibold text-slate-900 cursor-pointer list-none">
          <span>Quais formas de pagamento são aceitas e há emissão de nota fiscal?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">⌄</span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          Aceitamos Pix, dinheiro e cartões. Para empresas, órgãos públicos ou prestação de contas, solicite previamente as condições de faturamento e emissão de nota fiscal no atendimento pelo WhatsApp.
        </p>
      </details>

      <details class="group bg-white rounded-xl border border-slate-200 p-5 open:shadow-sm transition">
        <summary class="flex items-center justify-between font-semibold text-slate-900 cursor-pointer list-none">
          <span>Como faço para reservar ou cotar para grupos/equipes?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">⌄</span>
        </summary>
        <p class="mt-3 text-sm text-slate-600 leading-relaxed">
          Você pode usar o simulador de diárias no topo da página ou clicar em "Cotar no WhatsApp" em qualquer apartamento. Para equipes, missões ou estadias prolongadas, envie a quantidade de quartos e datas para atendimento direto.
        </p>
      </details>
    </div>
  </div>
</section>

  <footer class="bg-slate-950 text-slate-400 py-8 text-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div><span class="text-white font-semibold">{hotelData.name}</span> • São Gabriel da Cachoeira - AM</div>
      <div class="text-xs text-slate-500">Desenvolvido por <span class="text-slate-300 font-medium">Simofy Tech</span></div>
    </div>
  </footer>

  <RoomGalleryModal />

<a
  href={`https://wa.me/${hotelData.whatsapp}?text=${encodeURIComponent(`Olá! Gostaria de falar com a recepção do ${hotelData.name}.`)}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
  class="fixed bottom-6 right-6 z-40 inline-flex items-center gap-2.5 rounded-full bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-base px-5 py-3.5 shadow-xl hover:shadow-2xl hover:-translate-y-0.5 transition-all"
>
  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm.029 18.88c-1.161 0-2.305-.292-3.318-.844l-3.677.964.984-3.595c-.607-1.052-.927-2.246-.926-3.468.001-3.825 3.113-6.937 6.937-6.937 1.856.001 3.598.723 4.907 2.034 1.31 1.311 2.031 3.054 2.03 4.908-.001 3.825-3.113 6.938-6.937 6.938z"/>
  </svg>
  <span>WhatsApp</span>
</a>

</body>
</html>